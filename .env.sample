# Reference gflbans/internal/config.py for all configs

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=gflbans_devel

REDIS_URI=redis://127.0.0.1:6379

# Grants all permissions to this Steam32 ID
ROOT_USER=1623

# The domain you're hosting this on
HOST=localhost:3335

# Required string, should be long and random!
SECRET_KEY=SECRETKEYHERE

PRODUCTION=False

# Replace all gflbans branding with your own branding
BRANDING=GFLBans

# Profile picture for discord embeds
COMMUNITY_ICON=https://bans.gflclan.com/static/images/gflbans256.png

# Branding for GFLBans in Discord embeds
GFLBANS_ICON=https://bans.gflclan.com/static/images/gflbans256.png

# DISCORD_BOT_TOKEN=BOTTOKEN

STEAM_API_KEY=APIKEYHERE

# Seconds a Steam login session stays valid
STEAM_OPENID_ACCESS_TOKEN_LIFETIME=604800

# https://iphub.info/account for VPN detection. 1k requests/day on free plan, but still requires key
# IPHUB_API_KEY=APIKEYHERE

# Seconds to cache IPHub results
IPHUB_CACHE_TIME=604800

# Global Discord webhook to print out infraction information
# GLOBAL_INFRACTION_WEBHOOK = ""

# True = use unix socket, False = use HTTP/TCP
WEB_USE_UNIX=False

# Socket path to listen on if using a unix socket
UNIX_SOCKET=/run/gflbans.sock

# Address and port to listen on if using HTTP/TCP
HTTP_HOST=127.0.0.1
HTTP_PORT=3335

# Number of web server worker processes
GFLBANS_WORKERS=3

# Max infraction attachment size in bytes (30 MB)
MAX_UPLOAD_SIZE=31457280

# (NON-FUNCTIONAL) Seconds to keep audit logs and chat logs
RETAIN_AUDIT_LOG_FOR=2592000
RETAIN_CHAT_LOG_FOR=2592000

# Seconds before cached server info is considered stale
SERVER_CACHE_STALE_AFTER=600

# Pre-select the playtime option when creating infractions.
AUTO_SELECT_PLAYTIME=True

# Auto stacking infraction settings.
# Playtime infractions will only stack with other playtime infractions. Same with real world timed infractions.
# Duration if no infraction history
AUTO_STACK_START_TIME=1800
# Max age of previous infractions to stack with (based on their creation date)
AUTO_STACK_MAX_AGE=31536000
# How much to multiply longest past duration by to get new duration
AUTO_STACK_MULTIPLIER=2.0
