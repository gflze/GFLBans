# Docker Compose variables (Dokploy: paste into the compose service's Environment tab).
# CONFIG_PATH and TEMPLATE_CONFIGS_PATH point at Dokploy file mounts (Advanced > Mounts), which live in ../files/.
# Application settings in Configs/.env follow .env.sample.
CONTAINER_NAME=gflbans
PORT=3335
CONFIG_PATH=../files/Configs/.env
TEMPLATE_CONFIGS_PATH=../files/Configs/templates
MONGODB_SOCKET_DIR=/run/mongodb
REDIS_SOCKET_DIR=/run/redis
